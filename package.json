{
  "name": "@ficsysfr/nestjs_module_ldap",
  "version": "1.0.1",
  "description": "LDAP module for NestJS built on ldapts",
  "repository": "https://github.com/FicSysFR/nestjs_module_ldap.git",
  "homepage": "https://ficsysfr.github.io/nestjs_module_ldap/",
  "bugs": {
    "url": "https://github.com/FicSysFR/nestjs_module_ldap/issues"
  },
  "keywords": [
    "ldap",
    "ldapts",
    "nestjs",
    "typescript",
    "nodejs",
    "dependency-injection",
    "directory-services",
    "npm-package"
  ],
  "author": "tacxou <12997062+tacxou@users.noreply.github.com> (https://github.com/tacxou)",
  "contributors": [
    {
      "name": " tacxou",
      "email": "12997062+tacxou@users.noreply.github.com",
      "url": "https://github.com/tacxou"
    },
    {
      "name": "Contributors",
      "url": "https://github.com/FicSysFR/nestjs_module_ldap/graphs/contributors"
    }
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/ldap.constants": {
      "types": "./dist/ldap.constants.d.ts",
      "import": "./dist/ldap.constants.js",
      "require": "./dist/ldap.constants.js",
      "default": "./dist/ldap.constants.js"
    },
    "./dist/ldap.core-module": {
      "types": "./dist/ldap.core-module.d.ts",
      "import": "./dist/ldap.core-module.js",
      "require": "./dist/ldap.core-module.js",
      "default": "./dist/ldap.core-module.js"
    },
    "./dist/ldap.decorators": {
      "types": "./dist/ldap.decorators.d.ts",
      "import": "./dist/ldap.decorators.js",
      "require": "./dist/ldap.decorators.js",
      "default": "./dist/ldap.decorators.js"
    },
    "./dist/ldap.interfaces": {
      "types": "./dist/ldap.interfaces.d.ts",
      "import": "./dist/ldap.interfaces.js",
      "require": "./dist/ldap.interfaces.js",
      "default": "./dist/ldap.interfaces.js"
    },
    "./dist/ldap.manager": {
      "types": "./dist/ldap.manager.d.ts",
      "import": "./dist/ldap.manager.js",
      "require": "./dist/ldap.manager.js",
      "default": "./dist/ldap.manager.js"
    },
    "./dist/ldap.module": {
      "types": "./dist/ldap.module.d.ts",
      "import": "./dist/ldap.module.js",
      "require": "./dist/ldap.module.js",
      "default": "./dist/ldap.module.js"
    },
    "./dist/ldap.utils": {
      "types": "./dist/ldap.utils.d.ts",
      "import": "./dist/ldap.utils.js",
      "require": "./dist/ldap.utils.js",
      "default": "./dist/ldap.utils.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "docs/assets/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build": "yarn typecheck && tsc -p tsconfig.build.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "changelog:build": "node scripts/build-changelog.mjs",
    "changelog:check": "node scripts/build-changelog.mjs --check",
    "package": "yarn build && node scripts/package.mjs",
    "package:check": "yarn build && node scripts/package.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/testing": "^11.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "ldapts": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^6.0.0 || ^7.0.0 || ^8.0.0 || ^9.0.0 || ^10.0.0 || ^11.0.0",
    "ldapts": "^7.0.0 || ^8.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=22.14.0",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
